# API listener configuration. These values are safe local-development defaults.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Optional identity/profile storage. Configure a local or test PostgreSQL instance before running migrations.
# DATABASE_URL=postgresql://wb:wb@127.0.0.1:5432/wb

# Optional OIDC authentication. Configure all three values together using a dedicated development or test issuer.
# OIDC_ISSUER=https://identity.example.test/
# OIDC_AUDIENCE=wb-api
# OIDC_JWKS_URI=https://identity.example.test/.well-known/jwks.json
